# Application Server Configuration
APP_NAME=ohive-backend
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# VLM (Vision-Language Model) Configuration
# Supported providers: 'hosted' (OpenRouter / HF Inference API), 'local' (PyTorch Qwen2-VL), or 'auto'
VLM_PROVIDER=hosted
VLM_MODEL_NAME=qwen/qwen-2.5-vl-72b-instruct:free
VLM_API_URL=https://openrouter.ai/api/v1/chat/completions
VLM_API_KEY=your_openrouter_or_vlm_api_key_here
VLM_DEVICE=auto
VLM_MAX_CONCURRENCY=2
VLM_MAX_NEW_TOKENS=512

# Optional Legacy / Direct HuggingFace Token
HF_TOKEN=
OPENROUTER_API_KEY=

# File Upload & Processing Parameters
MAX_FILE_SIZE_MB=10
MAX_BULK_FILES=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
TEMP_DIR=./temp

# Database Configuration (PostgreSQL for free-tier cloud deployment, SQLite for local dev)
# Example PostgreSQL URL: postgresql+psycopg://user:password@ep-sample-123.singapore.aws.neon.tech/ohive_db?sslmode=require
DATABASE_URL=sqlite:///./leads.db

# CORS Configuration (Comma-separated public frontend domain URLs)
CORS_ORIGINS=http://localhost:3000,https://ohive-lead-extractor.vercel.app
