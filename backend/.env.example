# Application Server Configuration
APP_NAME=ohive-vlm-backend
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Qwen Vision-Language Model (VLM) Configuration
# HuggingFace model repo ID
QWEN_MODEL_NAME=Qwen/Qwen2-VL-2B-Instruct
# Optional local path to pre-downloaded model directory (leave empty to fetch from HuggingFace)
QWEN_MODEL_PATH=
# Device: 'auto', 'cpu', or 'cuda'
QWEN_DEVICE=auto
# Maximum generation tokens for model output
QWEN_MAX_NEW_TOKENS=512

# File Upload & Processing Parameters
MAX_FILE_SIZE_MB=10
MAX_BULK_FILES=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
VLM_MAX_CONCURRENCY=2
TEMP_DIR=./temp

# Database Configuration
DATABASE_URL=sqlite:///./leads.db

# CORS Configuration (Comma-separated origins for Next.js frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
